# --- LLM Provider API Keys ---
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- App Config ---
# Local dev default:
DATABASE_URL=sqlite:///./modelpilot.db
# Supabase/Postgres — use the Session pooler connection string (Project
# Settings > Database > Connection string), not the direct db.<ref>.supabase.co
# host, which is IPv6-only and won't resolve on IPv4-only networks/containers.
# The password is shown once at project creation and isn't retrievable afterward.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
LOG_LEVEL=INFO

# --- Routing ---
# Local semantic primary with automatic structured Mistral fallback.
ROUTER_MODE=local
LOCAL_ROUTER_ARTIFACT_DIR=artifacts/local_router
BGE_CACHE_DIR=artifacts/bge
# Experimental raw-confidence safety signal; it is not a calibrated probability.
LOCAL_ROUTER_FALLBACK_THRESHOLD=0.60

# --- Frontend (Streamlit) ---
# Backend URL the Streamlit UI calls. Defaults to localhost for local dev.
# BACKEND_URL=http://localhost:8000
# Per-request timeout for /chat specifically (seconds). Default 180s covers
# the ADVANCED tier's real-world worst case (DeepSeek R1 reasoning latency).
# CHAT_TIMEOUT_SECONDS=180

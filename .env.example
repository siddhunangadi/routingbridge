# --- LLM Provider API Keys ---
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- App Config ---
# Local dev default:
DATABASE_URL=sqlite:///./modelpilot.db
# Supabase/Postgres (get the password from Project Settings > Database >
# Connection string in the Supabase dashboard — it's shown once and never
# retrievable via the API afterward):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
LOG_LEVEL=INFO

# --- Routing Thresholds (word count based, configurable) ---
EASY_MAX_WORDS=30
MEDIUM_MAX_WORDS=100
